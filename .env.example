# Copier en .env pour le développement local. En production, variables Railway.
TOWER_ENV=dev
TOWER_DATABASE_URL=postgresql://postgres@localhost:5432/tower
TOWER_LOG_LEVEL=info
# TOWER_LOG_FORMAT=console        # json par défaut hors dev
# TOWER_HOST=0.0.0.0              # "::" par défaut (requis par le réseau privé Railway)
TOWER_SERVICES=ping
# TOWER_QUEUES=default            # vide : toutes les files des services activés
TOWER_WORKER_CONCURRENCY=4
TOWER_CORS_ORIGINS=
