# TOWER_FC_LEVEL_BUDGETS_USD={"N0": 1, "N1": 5, "N2": 10, "N3": 20, "N4": 15}
# TOWER_FC_INSEE_INDICATORS=[{"indicator": "fr.unemployment_rate", "label": "Taux de chômage (BIT), France", "idbank": "001688527", "unit": "percent", "territory": "FR", "definition_variant": "ilo", "aliases": ["taux de chomage", "chomage"], "period": "quarter", "source_name": "INSEE"}]
