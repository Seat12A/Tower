# Copy to .env for local development. In production, use Railway variables.
TOWER_ENV=dev
TOWER_DATABASE_URL=postgresql://postgres@localhost:5432/tower
TOWER_LOG_LEVEL=info
# TOWER_LOG_FORMAT=console        # json by default outside dev
# TOWER_HOST=0.0.0.0              # "::" by default (required by the Railway private network)
TOWER_SERVICES=ping
# TOWER_QUEUES=default            # empty: all queues of the enabled services
TOWER_WORKER_CONCURRENCY=4
TOWER_CORS_ORIGINS=

# LLM providers (secrets: Railway variables only, never committed)
# TOWER_OPENAI_API_KEY=
# TOWER_OPENAI_API_KEY_SHARED=
# TOWER_ANTHROPIC_API_KEY=
# TOWER_OPENAI_USAGE_TIER=1
# TOWER_LLM_FREE_MARGIN=0.10

# Ingestion and fact-check
# TOWER_FC_LANGUAGES=fr,en
# TOWER_INGEST_MAX_ITEMS=50
# TOWER_INGEST_DAILY_QUOTA=500
# Verification of extension contents (X oEmbed, service ingest)
# TOWER_OEMBED_ENABLED=true
# TOWER_OEMBED_URL=https://publish.x.com/oembed
# TOWER_OEMBED_PER_MINUTE=30
# TOWER_OEMBED_DAILY_MAX=20000
# TOWER_OEMBED_CONCURRENCY=2
# TOWER_OEMBED_MAX_AGE_H=24
# TOWER_OEMBED_TIMEOUT_S=10
# TOWER_HTTP_USER_AGENT=Seat12A-Tower/0.1 (+https://example.org/contact)

# Fact-check pipeline (services factcheck and investigate)
# TOWER_LLM_FAKE=false            # fake model provider, refused when TOWER_ENV=prod
# TOWER_FC_DRAFT_DAILY_QUOTA=50
# TOWER_FC_CAP_STANDARD_USD=0.10
# TOWER_FC_CAP_REINFORCED_USD=0.40
# TOWER_FC_CAP_N4_USD=0.60
# TOWER_FC_SEARCHES_STANDARD=4
# TOWER_FC_SEARCHES_REINFORCED_EXTRA=4
# TOWER_FC_PASSAGES_STANDARD=30
# TOWER_FC_PASSAGES_REINFORCED=60
# TOWER_FC_PASSAGE_WORDS=120
# TOWER_FC_CONFIDENCE_COEFFICIENTS=   # JSON, e.g. {"second_opinion_same_side": 0.0}
# TOWER_FC_CONFIDENCE_CAP=0.90
# TOWER_FC_CONFIDENCE_HIGH=0.80
# TOWER_FC_CONFIDENCE_MEDIUM=0.55
# TOWER_FC_ESCALATION_THRESHOLD=0.60
# TOWER_FC_LOADED_TERMS_FILE=
# TOWER_FC_REFERENCE_LANGS=fr
# TOWER_FC_REVIEW_LOCALE_FALLBACK=fr
# --- Fact-check V1 (lot 4): embeddings, groups, reuse, profiles ---
# TOWER_FC_EMBED_BATCH_SIZE=2000
# TOWER_FC_EMBED_DEBOUNCE_SECONDS=30
# TOWER_FC_EMBEDDING_RETENTION_DAYS=14
# TOWER_FC_E1_SAMPLE_RATE=0.02
