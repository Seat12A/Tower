# Copy to .env for local development. In production, use Railway variables.
TOWER_ENV=dev
TOWER_DATABASE_URL=postgresql://postgres@localhost:5432/tower
TOWER_LOG_LEVEL=info
# TOWER_LOG_FORMAT=console        # json by default outside dev
# TOWER_HOST=0.0.0.0              # "::" by default (required by the Railway private network)
TOWER_SERVICES=ping
# TOWER_QUEUES=default            # empty: all queues of the enabled services
TOWER_WORKER_CONCURRENCY=4
TOWER_CORS_ORIGINS=

# LLM providers (secrets: Railway variables only, never committed)
# TOWER_OPENAI_API_KEY=
# TOWER_OPENAI_API_KEY_SHARED=
# TOWER_ANTHROPIC_API_KEY=
# TOWER_OPENAI_USAGE_TIER=1
# TOWER_LLM_FREE_MARGIN=0.10

# Ingestion and fact-check
# TOWER_FC_LANGUAGES=fr,en
# TOWER_INGEST_MAX_ITEMS=50
# TOWER_INGEST_DAILY_QUOTA=500
# TOWER_HTTP_USER_AGENT=Seat12A-Tower/0.1 (+https://example.org/contact)

# Budgets
# TOWER_BUDGET_RESERVATION_TTL_S=1800

# Radar (hangar service "radar"; secret: Railway variables only)
# TOWER_X_BEARER_TOKEN=
# TOWER_X_API_BASE=https://api.x.com
# TOWER_X_PRICE_POST_READ_USD=0.005
# TOWER_X_PRICE_USER_READ_USD=0.010
# TOWER_X_MONTHLY_CAP_USD=20
# TOWER_RADAR_MAX_RESULTS=20
# TOWER_RADAR_MAX_PAGES=3
# TOWER_RADAR_EXCLUDE=retweets
# TOWER_RADAR_INTERVAL_HIGH_S=120
# TOWER_RADAR_INTERVAL_NORMAL_S=600
# TOWER_RADAR_INTERVAL_LOW_S=1800
# TOWER_RADAR_INTERVAL_MIN_S=60
# TOWER_RADAR_INTERVAL_MAX_S=21600
# TOWER_RADAR_EXPECTED_POSTS_PER_POLL=2
# TOWER_RADAR_SCHEDULE_BATCH=100

# intercom (Discord bot; secrets: Railway variables only)
# TOWER_DISCORD_TOKEN=
# TOWER_DISCORD_GUILD_ID=
# TOWER_DISCORD_CHANNEL_INCIDENTS=
# TOWER_DISCORD_CHANNEL_BUDGET=
# TOWER_DISCORD_CHANNEL_DOSSIERS=
# TOWER_DISCORD_CHANNEL_ADMIN=
# TOWER_DISCORD_LOCALE=fr
# TOWER_GATE_URL=http://localhost:8000
# TOWER_GATE_TOKEN=
# TOWER_INTERCOM_CURSOR_NAME=intercom
