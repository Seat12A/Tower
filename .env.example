# Copy to .env for local development. In production, use Railway variables.
TOWER_ENV=dev
TOWER_DATABASE_URL=postgresql://postgres@localhost:5432/tower
TOWER_LOG_LEVEL=info
# TOWER_LOG_FORMAT=console        # json by default outside dev
# TOWER_HOST=0.0.0.0              # "::" by default (required by the Railway private network)
TOWER_SERVICES=ping
# TOWER_QUEUES=default            # empty: all queues of the enabled services
TOWER_WORKER_CONCURRENCY=4
TOWER_CORS_ORIGINS=
