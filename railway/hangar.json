{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "pyproject.toml", "uv.lock", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "tower hangar",
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": "0",
    "drainingSeconds": "30"
  }
}
